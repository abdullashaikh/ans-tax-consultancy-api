# ================================================================
# ANS Tax Consultancy — Backend API Environment Configuration
# ================================================================
# Copy this file to .env and fill in the appropriate values.
# NEVER commit the actual .env file with production secrets.
# ================================================================

# Application
NODE_ENV=development
PORT=5000
APP_NAME=ANS Tax Consultancy API
API_VERSION=v1
APP_URL=http://localhost:5000
API_PREFIX=/api/v1

# Frontend URLs for CORS Whitelist (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://anstaxconsultancy.com,https://admin.anstaxconsultancy.com

# Database Connection (MySQL 8+)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_ans_tax_consultancy
DB_USER=root
DB_PASSWORD=your_database_password_here
DB_CONNECTION_LIMIT=20
DB_WAIT_FOR_CONNECTIONS=true
DB_QUEUE_LIMIT=0
DB_TIMEZONE=+00:00
DB_SSL=false

# JWT Authentication Secrets (Generate using: openssl rand -hex 64)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters_long_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_long_here
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Cookie Configuration
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_SECRET=your_cookie_secret_key_minimum_32_characters_long_here

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=10
LEAD_RATE_LIMIT_MAX_REQUESTS=15

# Security & Encryption (AES-256-GCM - 32 bytes hex)
ENCRYPTION_KEY=your_32_bytes_hex_encryption_key_here

# Email & Resend OTP Provider Configuration
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=noreply@anstaxconsultancy.com

# OTP Security & Rate Limiting
OTP_EXPIRATION_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_RESENDS=3
OTP_REQUEST_RATE_LIMIT_WINDOW_MS=900000
OTP_REQUEST_RATE_LIMIT_MAX=3

# Object Storage (Private Cloud Bucket for Documents)
STORAGE_PROVIDER=S3
STORAGE_BUCKET=ans-tax-private-documents
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
SIGNED_URL_EXPIRY_SECONDS=900

# Payment Gateway (Razorpay / Stripe)
PAYMENT_PROVIDER=RAZORPAY
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
